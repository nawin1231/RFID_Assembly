# Copy to .env and fill in. Never commit .env — it holds the AS400 API token.

# ── Server ────────────────────────────────────────────────────────────────
PORT=5001

# ── Database ──────────────────────────────────────────────────────────────
# Windows Authentication (trustedConnection) — no user/password needed.
# Point DB_NAME at the dev database while developing.
DB_SERVER=HOSTNAME\SQLEXPRESS
DB_NAME=db_rfid_assembly_dev

# ── AS400 API ─────────────────────────────────────────────────────────────
# Include the "Bearer " prefix — it is sent as the Authorization header as-is.
API_TOKEN=Bearer xxxxxxxxxxxxxxxx

# Lot info lookup. The backend appends /{lot_no}.
API_RECEIVE_URL=http://eweb8.ay.minebea.local:8087/BearingAYDataApi/api/v1/assembly/GaugeRec/gauge-receiving

# Gauge result polling — PENDING, not yet provided by IT.
# Leave blank until then; the polling loop that uses it is commented out.
API_PROD_RESULT_URL=
